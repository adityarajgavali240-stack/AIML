# ─── AI Provider Selection ───────────────────────────────────────────────────
# Choose the active provider: claude | openai | gemini
AI_PROVIDER=claude

# ─── Anthropic Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# CLAUDE_MODEL=claude-3-5-sonnet-20241022   # optional — uses default if unset

# ─── OpenAI GPT ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o                       # optional — uses default if unset

# ─── Google Gemini ───────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
# GEMINI_MODEL=gemini-1.5-flash             # optional — uses default if unset
